# =============================================================================
# .env.example  — copy to .env for LOCAL runs only.
#
# SECURITY MANDATE: In CI, these values MUST come from the CI/CD secret vault
# (GitHub Actions secrets, Azure Key Vault, HashiCorp Vault, etc.) and be
# injected as environment variables at runtime. Never commit a real .env file.
# The config loader reads process.env regardless of source, so vault-injected
# variables and local .env behave identically.
# =============================================================================

# Which environment profile to load: dev | staging | prod
TEST_ENV=dev

# --- Auth credentials (restful-booker default demo creds) --------------------
# In CI these are pulled from the vault; locally you may set them here.
BOOKER_USERNAME=admin
BOOKER_PASSWORD=password123

# --- Optional per-environment base URL overrides -----------------------------
# If unset, config/environments.ts defaults are used.
# BASE_URL_DEV=https://restful-booker.herokuapp.com
# BASE_URL_STAGING=https://restful-booker.herokuapp.com
# BASE_URL_PROD=https://restful-booker.herokuapp.com

# --- Throttling / rate limiting ----------------------------------------------
# Minimum milliseconds between outgoing requests per worker (0 = disabled).
REQUEST_MIN_INTERVAL_MS=150

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=info
